{
  "name": "typeson-registry",
  "version": "14.3.0",
  "description": "The type registry for typeson",
  "author": "dfahlander",
  "contributors": [
    "Brett Zamir"
  ],
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.umd.min.cjs",
  "module": "./index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.min.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.umd.min.cjs"
      },
      "default": "./dist/index.umd.min.cjs"
    },
    "./polyfills": {
      "import": {
        "types": "./dist/polyfills/index.d.ts",
        "default": "./polyfills/index.js"
      },
      "require": {
        "types": "./dist/polyfills/index.d.cts",
        "default": "./polyfills/index.cjs"
      },
      "default": "./polyfills/index.cjs"
    },
    "./*": "./*"
  },
  "scripts": {
    "prepublishOnly": "pnpm i && pnpm build && pnpm attw",
    "attw": "attw --pack . --profile node16",
    "tsc": "tsc && node tools/append-to-declaration-files.js",
    "tsc:ts7": "npx --yes --package=typescript@7 -- tsc -p tsconfig.json && npx --yes --package=typescript@7 -- tsc -p tsconfig-build.json --noEmit",
    "eslint": "eslint .",
    "lint": "npm run eslint --",
    "start": "static -p 8085",
    "rollup": "node ./build.js",
    "build": "npm run rollup && tsc -p tsconfig-build.json",
    "mocha": "mocha --require chai/register-expect.js --require chai/register-assert.js test/*.js",
    "open-coverage": "open-cli http://localhost:8085/coverage/ && npm start",
    "test:unit": "npm run mocha",
    "coverage": "rm -Rf node_modules/.cache && c8 npm run test:unit",
    "test-nocov": "npm run build && npm run eslint && npm run coverage",
    "test": "npm run build && npm run eslint && npm run coverage",
    "test:worker-open": "open-cli http://localhost:8085/browser-test/worker.html && npm start",
    "test:browser-open": "open-cli http://localhost:8085/browser-test/ && npm start",
    "test:browser": "npm run build && npm run eslint && npm run test:browser-open"
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "check-coverage": true,
    "branches": 100,
    "lines": 100,
    "functions": 100,
    "statements": 100,
    "exclude": [
      "build.js",
      "dist",
      ".ncurc.cjs",
      "eslint.config.js",
      "browser-test",
      "coverage",
      "test/**",
      "node_modules/**"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dfahlander/typeson-registry.git"
  },
  "browserslist": [
    "cover 100%"
  ],
  "keywords": [
    "typeson",
    "JSON",
    "remoting",
    "universal"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dfahlander/typeson-registry/issues"
  },
  "homepage": "https://github.com/dfahlander/typeson-registry#readme",
  "engines": {
    "node": "^22.16.0 || >=24.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@eslint/markdown": "^8.0.3",
    "@node-static/node-static": "^0.9.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chai": "^5.2.3",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/semver": "^7.8.0",
    "@types/whatwg-url": "^13.0.0",
    "c8": "^12.0.0",
    "canvas": "^3.2.3",
    "chai": "^6.2.2",
    "eslint": "^10.8.1",
    "eslint-config-ash-nazg": "^42.5.0",
    "eslint-plugin-n": "^18.3.0",
    "jsdom": "^30.0.1",
    "mocha": "^11.8.0",
    "open-cli": "^9.0.0",
    "rollup": "^4.62.4",
    "semver": "^7.8.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "base64-arraybuffer-es6": "^3.1.0",
    "typeson": "^10.2.0",
    "whatwg-url": "^17.1.0"
  },
  "tonicExample": "var Typeson = require('typeson');\nvar TSON = new Typeson().register(require('typeson-registry/dist/presets/builtin'));\n\nTSON.stringify({foo: new Date()}, null, 2);"
}
